# Jev Trader CPU — env reference
# The Railway template wires everything automatically (zero deploy-form fields).
# Only set these if you run the repo yourself.

# mock | jev | jev-local (default). jev-local = decisions from a local JevOS
# instance over HTTP ($0, no API key); jev = hosted TypeSafe API (needs key).
MODEL=jev-local
# Base URL of the JevOS sidecar, e.g. http://jevos.railway.internal:8080
JEV_BASE_URL=
# Only needed if the JevOS sidecar sets JEV_API_KEY.
JEV_API_KEY=
# Hosted TypeSafe Jev (MODEL=jev only). Not needed for jev-local.
TYPESAFE_AI_API_KEY=<redacted>

# Leave unset for the safe default: dry-run (real book, real local decisions,
# simulated fills). Set a key ONLY if you want live orders with real funds.
PRIVATE_KEY=
DRY_RUN=true

# Monad RPC (public endpoint is fine for dry runs).
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz

# Trading knobs (template bakes the defaults; override in Variables if needed).
HORIZON_BLOCKS=100
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100

PORT=3000
